# --- Server ---
PORT=5000

# --- Database ---
# Connection string for your MongoDB Atlas cluster or local mongod.
MONGO_URI=mongodb://127.0.0.1:27017/prompt_kaizen

# --- Auth ---
# IMPORTANT: replace with a long random secret in production.
JWT_SECRET=replace_this_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed origins. Add the user frontend (5173)
# and the admin frontend (5174) for local development.
CLIENT_URL=http://localhost:5173,http://localhost:5174

# --- Admin seed (used by `npm run seed:admin`) ---
# ADMIN_EMAIL doubles as the login identifier and can be a simple username
# (e.g. "Admin") or a real email address. Set ADMIN_RESET_PASSWORD=true to
# force the password to be reset every time the seed script runs.
ADMIN_NAME=Admin
ADMIN_EMAIL=Admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_RESET_PASSWORD=true

# --- Email (Nodemailer / Gmail SMTP) ---
# Generate a 16-character Gmail App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on
# the Gmail account). Paste it below with or without spaces — the transporter
# strips whitespace.
EMAIL_FROM_NAME=Prompt Kaizen
EMAIL_USER=your.address@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
OTP_TTL_MINUTES=2

# --- Account security (Phase 1) ---
# Failed logins before an account is temporarily locked, and how long the
# lock lasts. Per-IP rate limiting alone does not stop a distributed attempt
# against a single account.
MAX_FAILED_LOGINS=8
LOCK_MINUTES=15

# How long an emailed password-reset link stays valid.
RESET_TTL_MINUTES=30

# --- Rate limits ---
RATE_LIMIT_GENERAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=20
# Endpoints that send an email are capped far tighter, per IP, over 15 min.
RATE_LIMIT_EMAIL_PER_15MIN=5
# Per-authenticated-user cap on prompt analysis.
RATE_LIMIT_ANALYZE_PER_MIN=20

# --- Limits ---
LEADERBOARD_LIMIT=500
# Days to retain admin audit records before TTL expiry.
AUDIT_RETENTION_DAYS=730

# --- SMTP resilience ---
# Caps on the mail path. Without these, nodemailer inherits the OS TCP timeout
# (~75s), so an unreachable SMTP host holds API requests open until the
# connection pool is exhausted.
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_SEND_TIMEOUT_MS=20000
SMTP_MAX_CONNECTIONS=3

# --- Local development without email ---
# When EMAIL_USER/EMAIL_PASSWORD are unset AND NODE_ENV is not "production",
# one-time codes and reset links are printed to the server console instead of
# being emailed, so signup stays testable locally. This is gated on NODE_ENV
# and cannot be enabled in production by any environment variable.

# --- LLM scoring (Phase 2) ---
# The rule-based analyzer always runs and is the fallback. When this is enabled
# AND a key is present, an LLM additionally scores the same 10-parameter rubric
# and rewrites the learner's own prompt. Every failure mode — missing key,
# timeout, rate limit, refusal, malformed output — degrades to the rule-based
# result, so a vendor outage never fails a request.
LLM_ANALYSIS_ENABLED=false
OPENAI_API_KEY=

# gpt-4o-mini is the default: this runs on every submission, and on a
# fixed-rubric scoring task the quality gap to gpt-4o does not justify roughly
# 20x the cost. Set OPENAI_MODEL=gpt-4o if evaluation quality proves
# insufficient on real submissions.
OPENAI_MODEL=gpt-4o-mini

# Per-attempt timeout, retry count, and a hard ceiling on the whole evaluation.
# Worst case is min(TIMEOUT x (RETRIES+1), TOTAL_BUDGET) before falling back.
OPENAI_TIMEOUT_MS=12000
OPENAI_MAX_RETRIES=1
OPENAI_TOTAL_BUDGET_MS=25000
