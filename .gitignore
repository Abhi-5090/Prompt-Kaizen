# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node — covers every workspace at any depth
**/node_modules/
**/dist/

# Environment files — secrets must never be committed
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editor / IDE
.vscode/
.idea/
*.swp

# Backups left over from monorepo conversion (per-app .git dirs renamed
# while creating this combined repo). Not meant to be tracked here.
**/.git.parent-monorepo-backup/

# Playwright end-to-end artifacts (browsers, traces, videos, reports)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.cache/

# Vite local env overrides used when running the stack locally
**/.env.local
